-- controller
function cmd_lft(p)
	p.dx=-p.speed
	p.dir=0
end

function cmd_rght(p)
	p.dx=p.speed
	p.dir=1
end

function cmd_jmp(p)
	if p.onground then
		p.dy=p.initaccel
		p.onground=false
		actions.notify("jump")
	end
end

binds={
	[0]=cmd_lft,
	[1]=cmd_rght,
	[4]=cmd_jmp,
	[5]=cmd_jmp
}

function read_plyr_cmds()
	local cmds={}
	for b=0,1 do
		if btn(b) then add(cmds,binds[b]) end
	end
	for b=4,5 do
		if btnp(b) then add(cmds,binds[b]) end
	end
	return cmds
end
