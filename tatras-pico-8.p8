-- main
function _init()
	poke(0x5f00+92,255)
	maplvl=split2d"0,128,0,896|128,256,0,896|0,512,896,1024"
	spawns=split2d"24,104|25,192|960,448"
	enemyspr=split2d"64,4,2"
	lvl=1
	t=0
	init_audio()
	restart()
end

function restart()
	player.hp=player.maxhp
	load_level()
end

function next_level()
	if lvl<#maplvl then
		lvl+=1
		load_level()
	end
end

function load_level()
	reload(0x1000,0x1000,0x2000)

	mymin,mymax,mxmin,mxmax=unpack(maplvl[lvl])
	camera()

	player.x, player.y=spawnp()
	player.dx,player.dy,player.ax,player.ay=0,0,0,0
	player.onground=true
	player.invul=0
	player.knock=0
	player.hop=false
	player.fate=nil
	anim_init(player,anims,"idle")

	ens={}
	rocks={}

	scan_map()
	upd_cam()
	seed_clouds()
end

function eat_fruit(p)
	local x1=(p.x+2)\8
	local y1=(p.y+2)\8
	local x2=(p.x+13)\8
	local y2=(p.y+15)\8
	if (p.hp<p.maxhp) then
		for tx=x1,x2 do
			for ty=y1,y2 do
				if mget(tx,ty)==102 then
					p.hp=min(p.hp+2,p.maxhp)
					mset(tx,ty,101)
					actions.notify("heal")
				end
			end
		end
	end
	
end

function make_en(esp,ex,ey,ew,eh)
	local e={
		sp=esp,
		sw=ew,sh=eh,
		x=ex,y=ey,
		dx=0,dy=0,ax=0,ay=0,
		dir=-1,
		g=0.5,
		hx=0,hy=0,
		hw=8,hh=eh*8,
		cm=true,cw=false,
		sm={current=nil}
	}
	anim_init(e,enemy_anims,"walk")
	sm_change(e,st_patrol)
	add(ens,e)
end

function begin_death()
	player.dx=0
	player.dy=0
	player.play="hold"
	player.fate="die"
	actions.notify("die")
	animate(player)
end

function begin_angel()
	player.y=cy+114
	player.dx=0
	player.dy=0
	player.dir=0
	player.play="angel"
	player.fate="angel"
	player.t=0
	actions.notify("die")
end

function update_fate()
	if player.fate=="angel" then
		if player.t>=60 then
			restart()
			return
		end
		player.y-=2
		player.t+=1
		animate(player)
	else
		animate(player)
		if player.done then
			restart()
		end
	end
end

function cloud_y()
	if lvl==3 then
		return cy+rnd(112)
	end
	return cy+4+rnd(40)
end

function mk_cloud(x)
	add(clouds,{
		x=x,
		y=cloud_y(),
		spd=rnd(0.2)+0.2,
		flip=rnd(2)<1
	})
end

function seed_clouds()
	clouds={}
	for i=1,3 do
		mk_cloud(cx+rnd(96))
	end
end

function upd_clouds()
	if #clouds<4 and t%60==0 then
		mk_cloud(cx+128)
	end
	for c in all(clouds) do
		c.x-=c.spd
		if c.x+32<cx then
			del(clouds,c)
		end
	end
end

function draw_clouds()
	camera(cx,cy)
	for c in all(clouds) do
		spr(103,c.x,c.y,4,2,c.flip)
	end
end

function _update()
	t+=1
	if t>=32000 then
		t-=32000
	end

	if player.fate then
		update_fate()
		return
	end

	player:update()
	if player.fate then
		return
	end

	for e in all(ens) do
		sm_update(e)
	end
	resolve_enemies()
	if player.fate then
		return
	end

	if (lvl==3) upd_rocks()
	if player.fate then
		return
	end

	if player.y>mymax then
		begin_angel()
		update_fate()
		return
	end	

	if (tmap(player,1)) next_level()
	upd_clouds()
	upd_cam()
end

function _draw()
	cls(12)
	draw_clouds()
	mapcam()
	map()
	for e in all(ens) do
		spr(e.sp,e.x,e.y,e.sw,e.sh,e.dir~=-1)
		if e.sm.current==st_chase then
			spr(118,e.x+12,e.y-8)
		end
	end
	for r in all(rocks) do
		spr(r.sp,r.x,r.y)
	end
	player:draw()
	camera()
	drw_hud()
end

function drw_hud()
	for i=0,2 do
		local n=player.hp-i*2
		local s=114
		if n>=2 then
			s=112
		elseif n==1 then
			s=113
		end
		spr(s,2+i*9,2)
	end
end
