-- SFX observer
sfx_ids={
	jump=0,
	heal=1,
	hurt=2,
	walk=3,
	brk=4
}

function on_sfx(event)
	local id=sfx_ids[event]
	if id then
		sfx(id)
	end
end

function init_audio()
	actions.sub("jump",on_sfx)
	actions.sub("heal",on_sfx)
	actions.sub("hurt",on_sfx)
	actions.sub("walk",on_sfx)
	actions.sub("brk",on_sfx)
end

