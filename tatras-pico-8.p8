-- enemy --
enemy_anims={
	walk={fr=6,64,68}
}
function hurt(o,n)
	if overlap(player.x+2,player.y+2,12,14,o.x,o.y,o.sw*8,o.sh*8)
	and player.invul<=0 then
		player.hp-=n
		player.invul=50
		player.play="hurt"
		actions.notify("hurt")
		if player.hp<=0 then
			restart()
			return true
		end
	end
end

function upd_enemy(e)
	e.hx=e.dir==1 and e.sw*8-e.hw or 0
	e.dx=e.dir*e.spd
	e.dy+=e.g
	move_and_collide(e)
	-- turn around at a wall or ledge--
	if cmap(e,e.x+e.dir*8,e.y) or not cmap(e,e.x+e.dir*8,e.y+1) then
		e.dir*=-1
	end
	animate(e)
end

function upd_rocks()
	local camx=mxmax-128
	local camy=mid(mymin, player.y-64, mymax-128)
	if t%30==0 then
		mk_rock(camx+rnd(120),camy-8)
	end
		for r in all(rocks) do
			if upd_rock(r,camy) then
				return
			end
		end
end

rock_anims={
	fall={fr=1,38},
	brk={fr=3,once=true,39,40}
}

function mk_rock(x,y)
	local r={
		x=x,
		y=y,
		spd=rnd(1)+1,
		sp=38, sw=1, sh=1,
		cm=true,
		hx=0,hy=0,hw=8,hh=8
	}

	anim_init(r,rock_anims,"fall")
	add(rocks,r)
end

function upd_rock(r,camy)
	if r.y>camy+128 then
		del(rocks,r)
		return
	end
	if r.play!="brk" then
		r.y+=r.spd
		if hurt(r,1) then
			return true
		end
		if cmap(r,r.x,r.y+1) then
			r.play="brk"
			actions.notify("brk")
		end
	end
	animate(r)
	if r.done then
		del(rocks,r)
	end
end
-->8
-- map --
-- world bounds --
function cmap(o,x,y)
	x=x or o.x
	y=y or o.y
	
	local ct=false
	local cb=false
	
	-- colliding with map tiles --
	if o.cm then
		local bx=x+o.hx
		local by=y+o.hy
		local x1=bx/8
		local y1=by/8
		local x2=(bx+o.hw-1)/8
		local y2=(by+o.hh-1)/8
		
		ct=fget(mget(x1,y1),0) or fget(mget(x1,y2),0)
		or fget(mget(x2,y2),0) or fget(mget(x2,y1),0)
	end

-- colliding with world bounds --
	if o.cw then
		cb=x<mxmin or x+16>mxmax
		or y<mymin
	end

	return ct or cb
end

function tmap(o,f)
	local bx,by=o.x+o.hx,o.y+o.hy
	local x1,y1=bx/8,by/8
	local x2,y2=(bx+o.hw-1)/8,(by+o.hh-1)/8

	return fget(mget(x1,y1),f)
		or fget(mget(x1,y2),f)
		or fget(mget(x2,y1),f)
		or fget(mget(x2,y2),f)
end

-- move object o by its dx/dy, stop at walls --
function move_and_collide(o)
	o.ax+=o.dx
	o.ay+=o.dy
	local nx=flr(abs(o.ax))
	local ny=flr(abs(o.ay))
	local sx=sgn(o.ax)
	local sy=sgn(o.ay)
	o.ax-=nx*sx
	o.ay-=ny*sy
	
	for i=1,nx do
		if cmap(o,o.x+sx,o.y) then o.dx=0 o.ax=0 break end
		o.x+=sx
	end
	for i=1,ny do
		if cmap(o,o.x,o.y+sy) then o.dy=0 o.ay=0 break end
		o.y+=sy
	end
end

function upd_cam()
	cx=mid(mxmin,player.x-64,mxmax-128)
	cy=mid(mymin,player.y-64,mymax-128)
end

function mapcam()
	camera(cx, cy)
end
-->8
-- controller
function cmd_lft(p)
	p.dx=-p.speed
	p.dir=0
end

function cmd_rght(p)
	p.dx=p.speed
	p.dir=1
end

function cmd_jmp(p)
	if p.onground then
		p.dy=p.initaccel
		p.onground=false
		actions.notify("jump")
	end
end

binds={
	[0]=cmd_lft,
	[1]=cmd_rght,
	[4]=cmd_jmp,
	[5]=cmd_jmp
}

function read_plyr_cmds()
	local cmds={}
	for b=0,1 do
		if btn(b) then add(cmds,binds[b]) end
	end
	for b=4,5 do
		if btnp(b) then add(cmds,binds[b]) end
	end
	return cmds
end
-->8
--animations
anims={
	idle={fr=20,1,3},
	walk={fr=6,5,7,9},
	jump={fr=6,11,13},
	hurt={fr=10,next="idle",32}
}

function anim_init(o,set,name)
	o.anims=set
	o.play=name
	o.state=name
	o.animindex=1
	o.time=0
end

function animate(o)
	local a=o.anims[o.state]
	if o.state!=o.play then
	 o.state=o.play
	 o.animindex=1
	 o.time=0
	 a=o.anims[o.state]
	elseif #a>1 or a.next or a.once then
	 o.time+=1
	 if o.time>=a.fr then
	  o.time=0
	  o.animindex=(o.animindex%#a)+1
	  if o.animindex==1 and a.next then
	   o.play=a.next
	   o.state=o.play
	   a=o.anims[o.state]
	  elseif o.animindex==1 and a.once then
		o.done=true
	  end
	 end
	end
	o.sp=a[o.animindex]
end
-->
-- subscriber
actions = {
	subs={}
}

function actions.sub(event,fn)
	local list=actions.subs[event]
	if not list then
		list={}
		actions.subs[event]=list
	end
	add(list,fn)
end

function actions.unsub(event,fn)
	local list=actions.subs[event]
	if list then
		rem(list,fn)
	end
end

function actions.notify(event)
	local list=actions.subs[event]
	if not list then return end
	for fn in all(list) do
		fn(event)
	end
end
