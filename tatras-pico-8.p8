pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- tools --
function split2d(s)
	local arr=split(s,"|",false)
	for k,v in pairs(arr) do
		arr[k]=split(v)
	end
	return arr
end

function spawnp()
	return unpack(spawns[lvl])
end

function overlap(ax,ay,aw,ah,bx,by,bw,bh)
	return ax<bx+bw and bx<ax+aw and ay<by+bh and by<ay+ah
end

function scan_map()
	for x=mxmin/8,mxmax/8 do
		for y=mymin/8,mymax/8 do
			parse_tile(mget(x,y),x,y)
		end
	end
end

function parse_tile(tle,x,y)
	local _x,_y=x*8,y*8

	if tle==10 then
		local esp,ew,eh=unpack(enemyspr[1])
		make_en(esp,_x,_y,ew,eh)
		mset(x,y,0)
	end
end
-->8
-- main
function _init()
	poke(0x5f00+92,255)
	lvl,tlvl=1,5
	t=0
	start_game()
end

function start_game()
	reload(0x1000,0x1000,0x2000)

	maplvl=split2d"0,128,0,896|128,256,0,896|0,512,896,1024"
	spawns=split2d"24,104|25,192|960,448"
	enemyspr=split2d"6,4,2"

	mymin,mymax,mxmin,mxmax=unpack(maplvl[lvl])
	camera()

	player.x, player.y=spawnp()
	player.dx,player.dy,player.ax,player.ay=0,0,0,0
	player.onground=true
	player.hp=player.maxhp
	player.invul=0

	ens={}
	rocks={}

	scan_map()
	upd_cam()
end

function eat_fruit(p)
	local x1=(p.x+2)\8
	local y1=(p.y+2)\8
	local x2=(p.x+13)\8
	local y2=(p.y+15)\8
	if (p.hp<p.maxhp) then
		for tx=x1,x2 do
			for ty=y1,y2 do
				if mget(tx,ty)==59 then
					p.hp=min(p.hp+2,p.maxhp)
					mset(tx,ty,58)
				end
			end
		end
	end
	
end

function make_en(esp,ex,ey,ew,eh)
	add(ens,{
		sp=esp,
		sw=ew,sh=eh,
		x=ex,y=ey,
		dx=0,dy=0,ax=0,ay=0,
		dir=-1,
		spd=0.5,
		g=0.5,
		hx=0,hy=0,
		hw=8,hh=eh*8,
		cm=true,cw=false,
		on_upd=upd_enemy
	})
end

function _update()
	t+=1
	if t>=32000 then
		t-=32000
	end

    player:update()
	for e in all(ens) do
		e.on_upd(e)
	end
	if (player.y > mymax) start_game()
	if (tmap(player,1)) lvl+=1 start_game()

	if (lvl==3) upd_rocks()

	if tmap(player,1) and lvl<tlvl then
		lvl+=1
		start_game()
	end
	upd_cam()
end

function _draw()
	cls(12)
	mapcam()
	map()
	for e in all(ens) do
		spr(e.sp,e.x,e.y,e.sw,e.sh,e.dir~=-1)
	end
	for r in all(rocks) do
		spr(r.sp,r.x,r.y)
	end
	player:draw()
	camera()
	drw_hud()
end

function drw_hud()
	for i=0,2 do
		local n=player.hp-i*2
		local s=56
		if n>=2 then
			s=54
		elseif n==1 then
			s=55
		end
		spr(s,2+i*9,2)
	end
end
-->8
-- player
player = {
    x=0,
    y=61,
    dx=0,
    dy=0,
    ax=0,
    ay=0,
    dir=2,    -- 0=left, 1=right, 2=up, 3=down
    sp = 1,
    speed = 2,
	maxhp=6,
	hp=6,
	invul=0,
	-- jump values --
	onground=true,
    initaccel= -5,
    g=0.5,
    -- feet hitbox --
    hx=4,
    hy=10,
    hw=8,
    hh=6,
    cm=true,  -- collide with map tiles
    cw=true, -- trigger room transition in edges
    update = function(self)
	 self.invul=max(self.invul-1,0)
     self.dx=0
     self.dy+=self.g
     if (btn(0)) self.dx=-self.speed self.dir=0 self.sp=1
     if (btn(1)) self.dx=self.speed self.dir=1 self.sp=1
     if btnp(4) and self.onground then
	 	self.dy=self.initaccel
		self.onground=false
	 end
     move_and_collide(self)
	 eat_fruit(self)
	 if cmap(self, self.x, self.y+1) then
	 	self.onground=true
	 else
	 	self.onground=false
	 end
	 -- enemy collision --
	 for e in all(ens) do
	 	if hurt(e,5) then
			return
		end
	 end
    end,
    draw = function(self)
        spr(self.sp,self.x,self.y,2,2,self.dir==1,false)
    end
}
-->8
-- enemy --
function hurt(o,n)
	if overlap(player.x+2,player.y+2,12,14,o.x,o.y,o.sw*8,o.sh*8)
	and player.invul<=0 then
		player.hp-=n
		player.invul=50
		if player.hp<=0 then
			start_game()
			return true
		end
	end
end

function upd_enemy(e)
	e.hx=e.dir==1 and e.sw*8-e.hw or 0
	e.dx=e.dir*e.spd
	e.dy+=e.g
	move_and_collide(e)
	-- turn around at a wall or ledge--
	if cmap(e,e.x+e.dir*8,e.y) or not cmap(e,e.x+e.dir*8,e.y+1) then
		e.dir*=-1
	end
end

function upd_rocks()
	local camx=mxmax-128
	local camy=mid(mymin, player.y-64, mymax-128)
	if t%30==0 then
		mk_rock(camx+rnd(120),camy-8)
	end
		for r in all(rocks) do
			if upd_rock(r,camy) then
				return
			end
		end
end

function mk_rock(x,y)
	add(rocks,{
			x=x,
			y=y,
			spd=rnd(1)+1,
			sp=38, sw=1, sh=1
		})
end

function upd_rock(r,camy)
	r.y+=r.spd
	if hurt(r,1) then
		return true
	end
	if cmap(r,r.x,r.y+1) or r.y>camy+128 then
		del(rocks,r)
	end
end
-->8
-- map --
-- world bounds --
function cmap(o,x,y)
	x=x or o.x
	y=y or o.y
	
	local ct=false
	local cb=false
	
	-- colliding with map tiles --
	if o.cm then
		local bx=x+o.hx
		local by=y+o.hy
		local x1=bx/8
		local y1=by/8
		local x2=(bx+o.hw-1)/8
		local y2=(by+o.hh-1)/8
		
		ct=fget(mget(x1,y1),0) or fget(mget(x1,y2),0)
		or fget(mget(x2,y2),0) or fget(mget(x2,y1),0)
	end

-- colliding with world bounds --
	if o.cw then
		cb=x<mxmin or x+16>mxmax
		or y<mymin
	end

	return ct or cb
end

function tmap(o,f)
	local bx,by=o.x+o.hx,o.y+o.hy
	local x1,y1=bx/8,by/8
	local x2,y2=(bx+o.hw-1)/8,(by+o.hh-1)/8

	return fget(mget(x1,y1),f)
		or fget(mget(x1,y2),f)
		or fget(mget(x2,y1),f)
		or fget(mget(x2,y2),f)
end

-- move object o by its dx/dy, stop at walls --
function move_and_collide(o)
	o.ax+=o.dx
	o.ay+=o.dy
	local nx=flr(abs(o.ax))
	local ny=flr(abs(o.ay))
	local sx=sgn(o.ax)
	local sy=sgn(o.ay)
	o.ax-=nx*sx
	o.ay-=ny*sy
	
	for i=1,nx do
		if cmap(o,o.x+sx,o.y) then o.dx=0 o.ax=0 break end
		o.x+=sx
	end
	for i=1,ny do
		if cmap(o,o.x,o.y+sy) then o.dy=0 o.ay=0 break end
		o.y+=sy
	end
end

function upd_cam()
	cx=mid(mxmin,player.x-64,mxmax-128)
	cy=mid(mymin,player.y-64,mymax-128)
end

function mapcam()
	camera(cx, cy)
end
