__lua__
-- tools --
function split2d(s)
	local arr=split(s,"|",false)
	for k,v in pairs(arr) do
		arr[k]=split(v)
	end
	return arr
end

function spawnp()
	return unpack(spawns[lvl])
end

function overlap(ax,ay,aw,ah,bx,by,bw,bh)
	return ax<bx+bw and bx<ax+aw and ay<by+bh and by<ay+ah
end

function scan_map()
	for x=mxmin/8,mxmax/8 do
		for y=mymin/8,mymax/8 do
			parse_tile(mget(x,y),x,y)
		end
	end
end

function parse_tile(tle,x,y)
	local _x,_y=x*8,y*8

	if tle==96 then
		local esp,ew,eh=unpack(enemyspr[1])
		make_en(esp,_x,_y,ew,eh)
		mset(x,y,0)
	end
end
-->8
-- main
function _init()
	poke(0x5f00+92,255)
	maplvl=split2d"0,128,0,896|128,256,0,896|0,512,896,1024"
	spawns=split2d"24,104|25,192|960,448"
	enemyspr=split2d"64,4,2"
	lvl=3
	t=0
	init_audio()
	restart()
end

function restart()
	player.hp=player.maxhp
	load_level()
end

function next_level()
	if lvl<#maplvl then
		lvl+=1
		load_level()
	end
end

function load_level()
	reload(0x1000,0x1000,0x2000)

	mymin,mymax,mxmin,mxmax=unpack(maplvl[lvl])
	camera()

	player.x, player.y=spawnp()
	player.dx,player.dy,player.ax,player.ay=0,0,0,0
	player.onground=true
	player.invul=0
	anim_init(player,anims,"idle")

	ens={}
	rocks={}

	scan_map()
	upd_cam()
end

function eat_fruit(p)
	local x1=(p.x+2)\8
	local y1=(p.y+2)\8
	local x2=(p.x+13)\8
	local y2=(p.y+15)\8
	if (p.hp<p.maxhp) then
		for tx=x1,x2 do
			for ty=y1,y2 do
				if mget(tx,ty)==59 then
					p.hp=min(p.hp+2,p.maxhp)
					mset(tx,ty,58)
					actions.notify("heal")
				end
			end
		end
	end
	
end

function make_en(esp,ex,ey,ew,eh)
	local e={
		sp=esp,
		sw=ew,sh=eh,
		x=ex,y=ey,
		dx=0,dy=0,ax=0,ay=0,
		dir=-1,
		spd=0.5,
		g=0.5,
		hx=0,hy=0,
		hw=8,hh=eh*8,
		cm=true,cw=false,
		on_upd=upd_enemy
	}
	anim_init(e,enemy_anims,"walk")
	add(ens,e)
end

function _update()
	t+=1
	if t>=32000 then
		t-=32000
	end

    player:update()
	for e in all(ens) do
		e.on_upd(e)
	end
	if (player.y > mymax) restart()
	if (tmap(player,1)) lvl+=1 next_level()

	if (lvl==3) upd_rocks()

	upd_cam()
end

function _draw()
	cls(12)
	mapcam()
	map()
	for e in all(ens) do
		spr(e.sp,e.x,e.y,e.sw,e.sh,e.dir~=-1)
	end
	for r in all(rocks) do
		spr(r.sp,r.x,r.y)
	end
	player:draw()
	camera()
	drw_hud()
end

function drw_hud()
	for i=0,2 do
		local n=player.hp-i*2
		local s=56
		if n>=2 then
			s=54
		elseif n==1 then
			s=55
		end
		spr(s,2+i*9,2)
	end
end
-->8
-- player
player = {
    x=0,
    y=61,
    dx=0,
    dy=0,
    ax=0,
    ay=0,
    dir=2,    -- 0=left, 1=right, 2=up, 3=down
    sp=1,
    speed=2,
	maxhp=6,
	hp=6,
	invul=0,
	-- jump values --
	onground=true,
    initaccel= -5,
    g=0.5,
    -- feet hitbox --
    hx=4,
    hy=10,
    hw=8,
    hh=6,
    cm=true,  -- collide with map tiles
    cw=true, -- trigger room transition in edges
    update = function(self)
	 self.invul=max(self.invul-1,0)
     self.dx=0
     self.dy+=self.g
     for cmd in all(read_plyr_cmds()) do
		cmd(self)
	 end
     move_and_collide(self)
	 eat_fruit(self)
	 if cmap(self, self.x, self.y+1) then
	 	self.onground=true
	 else
	 	self.onground=false
	 end
	 -- enemy collision --
	 for e in all(ens) do
	 	if hurt(e,5) then
			return
		end
	 end
	 if self.play!="hurt" and self.state!="hurt" then
		if not self.onground then
		 self.play="jump"
		elseif self.dx!=0 then
		 self.play="walk"
		else
		 self.play="idle"
		end
	   end
	   animate(self)
    end,
    draw = function(self)
		if self.invul>0 and self.invul%8<4 then
			for c=1,15 do
				pal(c,8)
			end
		end
        spr(self.sp,self.x,self.y,2,2,self.dir==1,false)
		pal()
    end
}
