-- player
player = {
    x=0,
    y=61,
    dx=0,
    dy=0,
    ax=0,
    ay=0,
    dir=2,    -- 0=left, 1=right, 2=up, 3=down
    sp=1,
    speed=2,
	maxhp=6,
	hp=6,
	invul=0,
	knock=0,
	kdx=0,
	hop=false,
	-- jump values --
	onground=true,
    initaccel= -5,
    g=0.5,
    -- feet hitbox --
    hx=4,
    hy=10,
    hw=8,
    hh=6,
    cm=true,  -- collide with map tiles
    cw=true, -- trigger room transition in edges
	update = function(self)
		if self.fate then return end
		self.invul=max(self.invul-1,0)
		if self.knock==0 and ride and self.onground
		and (btnp(4) or btnp(5)) then
		air=ride
		ride=nil
		end
		upd_plats()
		   self.dy+=self.g
		local locked=self.knock>0
		if locked then
		self.play="hurt"
		if self.ktx then
			local d=self.ktx-self.x
			if d!=0 then
				local s=d>0 and 1 or -1
				self.dx=s*min(2,abs(d))
				self.ax=0
			else
				self.dx=0
				self.ax=0
			end
		else
			self.dx=self.kdx
		end
		if self.hop then
			self.dy=-3
			self.hop=false
		end
		self.knock-=1
		if self.knock==0 then
			self.ktx=nil
		end
		else
		self.dx=0
		for cmd in all(read_plyr_cmds()) do
			cmd(self)
		end
		end
		local y0=self.y
		air_shift()
		   move_and_collide(self)
		stick_ride()
		try_board(y0)
		eat_fruit(self)
		upd_ledges()
		if ride or cmap(self, self.x, self.y+1) then
			self.onground=true
		if not ride then air=nil end
		else
			self.onground=false
		end
		if not locked then
		if not self.onground then
		 self.play="jump"
		elseif self.dx!=0 then
		 self.play="walk"
		else
		 self.play="idle"
		end
		end
		  animate(self)
		  end,
    draw = function(self)
		if not self.fate and self.invul>0 and self.invul%8<4 then
			for c=1,15 do
				pal(c,8)
			end
		end
        spr(self.sp,self.x,self.y,2,2,self.dir==1,false)
		pal()
		pal(9,142,1)
    end
}

