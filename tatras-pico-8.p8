-- tools --
function split2d(s)
	local arr=split(s,"|",false)
	for k,v in pairs(arr) do
		arr[k]=split(v)
	end
	return arr
end

function spawnp()
	return unpack(spawns[lvl])
end

function overlap(ax,ay,aw,ah,bx,by,bw,bh)
	return ax<bx+bw and bx<ax+aw and ay<by+bh and by<ay+ah
end

function scan_map()
	ledges={}
	plats={}
	ride=nil
	air=nil
	for y=mymin/8,mymax/8 do
		local ledge=nil
		local run=nil
		for x=mxmin/8,mxmax/8 do
			local tle=mget(x,y)
			parse_tile(tle,x,y)
			if tle==93 or tle==94 then
				if run and run.sp==tle then
					run.w+=8
				else
					run={
						sp=tle,pos=0,dir=1,
						sx=0,sy=0,
						hx=x*8,hy=y*8,
						w=8,h=8
					}
					add(plats,run)
				end
				mset(x,y,0)
				ledge=nil
			elseif fget(tle,2) then
				run=nil
				if not ledge then
					ledge={t=0,stage=0,cells={}}
					add(ledges,ledge)
				end
				add(ledge.cells,{x=x,y=y,sp=tle})
			else
				ledge=nil
				run=nil
			end
		end
	end
	plant_spawn()
end

function parse_tile(tle,x,y)
	local _x,_y=x*8,y*8
	local k=enemy_kinds[tle]
	if k then
		make_en(k,_x,_y)
		mset(x,y,0)
	end
end

ledge_anim={fr=15,125,126,127}

function ledge_paint(l,s)
	for c in all(l.cells) do
		mset(c.x,c.y,s or c.sp)
	end
end

function ledge_hit(l,x,y,w,h)
	for c in all(l.cells) do
		if overlap(x,y,w,h,c.x*8,c.y*8,8,8) then
			return true
		end
	end
end

function ledge_break(l)
	for c in all(l.cells) do
		mset(c.x,c.y,0)
	end
	l.gone=90
	actions.notify("brk")
end

function upd_ledge(l)
	if l.gone then
		if l.gone>0 then l.gone-=1 end
		if l.gone>0 or (not ride and ledge_hit(l,player.x,player.y,16,16)) then
			return
		end
		ledge_paint(l)
		l.gone=nil
		l.t=0
		l.stage=0
		return
	end

	local bx=player.x+player.hx
	local by=player.y+player.hy+1
	local fr=ledge_anim.fr
	local standing=not ride and ledge_hit(l,bx,by,player.hw,player.hh)
	if standing then
		l.t+=7
		if l.t>=fr*(#ledge_anim+1) then
			ledge_break(l)
			return
		end
		local stage=l.t\fr
		if stage>l.stage then
			l.stage=stage
			ledge_paint(l,ledge_anim[stage])
		end
	else
		l.t=max(l.t-1,0)
		local prev=l.stage-1
		if l.stage>0 and l.t<=fr*prev then
			l.stage=prev
			ledge_paint(l,prev>0 and ledge_anim[prev])
		end
	end
end

function upd_ledges()
	for l in all(ledges) do
		upd_ledge(l)
	end
end

plats={}
ride=nil
air=nil

plats={}
ride=nil
air=nil

function plat_at(p)
	local x,y=p.hx,p.hy
	if p.sp==93 then
		x+=flr(p.pos)
	else
		y-=flr(p.pos)
	end
	return x,y
end

function upd_plats()
	for p in all(plats) do
		local pos=p.pos+0.5*p.dir
		local dir=p.dir
		if pos>=32 then
			pos=32
			dir=-1
		elseif pos<=0 then
			pos=0
			dir=1
		end
		local d=flr(pos)-flr(p.pos)
		local dx,dy=d,0
		if p.sp==94 then
			dx,dy=0,-d
		end
		if ride==p and (dx!=0 or dy!=0)
		and cmap(player,player.x+dx,player.y+dy) then
			p.dir=-p.dir
			p.sx,p.sy=0,0
		else
			p.pos,p.dir=pos,dir
			p.sx,p.sy=dx,dy
			if ride==p then
				player.x+=dx
				player.y+=dy
			end
		end
	end
end

function over_x(p,px)
	local fx=player.x+player.hx
	return fx<px+p.w and px<fx+player.hw
end

function on_plat(p)
	local px,py=plat_at(p)
	local fx=player.x+player.hx
	local fy=player.y+player.hy+1
	return overlap(fx,fy,player.hw,player.hh,px,py,p.w,1)
end

function hit_plat(x,y)
	local bx=x+player.hx
	for p in all(plats) do
		if p!=ride then
			local px,py=plat_at(p)
			if overlap(bx,y,player.hw,16,px,py,p.w,8) then
				return true
			end
		end
	end
end

function plant_spawn()
	ride=nil
	air=nil
	for p in all(plats) do
		if on_plat(p) then
			ride=p
			player.onground=true
			return
		end
	end
end

function air_shift()
	if not air or air.sx==0 then return end
	local s=sgn(air.sx)
	for i=1,abs(air.sx) do
		if cmap(player,player.x+s,player.y) or hit_plat(player.x+s,player.y) then
			break
		end
	end
end

function stick_ride()
	if not ride then return end
	local px,py=plat_at(ride)
	local feet=player.y+16
	if over_x(ride,px) and feet>=py and feet<=py+1 then
		player.y=py-16
		player.dy=0
		player.ay=0
	else
		ride=nil
	end
end

function try_board(y0)
	if ride or player.y<=y0 then return end
	local b0=y0+16
	local b1=player.y+16
	for p in all(plats) do
		local px,py=plat_at(p)
		if b0<=py and b1>=py and over_x(p,px) then
			player.y=py-16
			player.dy=0
			player.ay=0
			ride=p
			air=nil
			return
		end
	end
end

function draw_plats()
	for p in all(plats) do
		local x,y=plat_at(p)
		for i=0,p.w/8-1 do
			spr(p.sp,x+i*8,y)
		end
	end
end

function color_lvl(lvl)
	if lvl==1 then
		pal(11,138,1)
		pal(12,140,1)
	elseif lvl==2 then
		pal(3,130,1)
		pal(11,136,1)
		pal(12,128,1)
	else
		pal(11,183,1)
		pal(12,130,1)
	end
end
