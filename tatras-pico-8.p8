--animations
anims={
	idle={fr=20,1,3},
	walk={fr=6,5,7,9},
	jump={fr=6,11,13},
	hurt={fr=10,32},
	hold={fr=20,next="die",32},
	die={fr=8,once=true,38,40,42},
	angel={fr=6,44,46}
}

function anim_init(o,set,name)
	o.anims=set
	o.play=name
	o.state=name
	o.animindex=1
	o.time=0
	o.done=false
end

function animate(o)
	local a=o.anims[o.state]
	if o.state!=o.play then
	 o.state=o.play
	 o.animindex=1
	 o.time=0
	 a=o.anims[o.state]
	elseif #a>1 or a.next or a.once then
	 o.time+=1
	 if o.time>=a.fr then
	  o.time=0
	  o.animindex=(o.animindex%#a)+1
	  if o.animindex==1 and a.next then
	   o.play=a.next
	   o.state=o.play
	   a=o.anims[o.state]
	  elseif o.animindex==1 and a.once then
		o.done=true
	  end
	 end
	end
	o.sp=a[o.animindex]
end
-->
-- subscriber
actions = {
	subs={}
}

function actions.sub(event,fn)
	local list=actions.subs[event]
	if not list then
		list={}
		actions.subs[event]=list
	end
	add(list,fn)
end

function actions.unsub(event,fn)
	local list=actions.subs[event]
	if list then
		rem(list,fn)
	end
end

function actions.notify(event)
	local list=actions.subs[event]
	if not list then return end
	for fn in all(list) do
		fn(event)
	end
end
